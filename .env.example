# Application Configuration
APP_NAME="Job Hunter Bot"
APP_VERSION="1.0.0"
DEBUG=false

# API Configuration
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security
SECRET_KEY="your-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="pdf,docx,doc"

# External Services
DISCORD_WEBHOOK_TIMEOUT=30
DISCORD_RETRY_ATTEMPTS=3
DISCORD_RETRY_DELAY=1

# Job Analysis
JOB_ANALYSIS_TIMEOUT=30
MAX_JOB_DESCRIPTION_LENGTH=50000

# CV Analysis
CV_ANALYSIS_TIMEOUT=60
SUPPORTED_LANGUAGES="en,es,fr,de"

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Database (for future use)
DATABASE_URL=""

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090